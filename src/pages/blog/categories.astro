---
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import { fetchBlogPosts } from "@/lib/fetchBlog";
import personalData from "@/data/global/personal.json";
import siteData from "@/data/global/site.json";
import { withBase } from "@/lib/assetPath";
import { getCollection } from "astro:content";
import localCategories from '@/data/blog/categories.json';

// Fetch external posts and local collection posts, then merge
const fetchedPosts = await fetchBlogPosts();
const localPostsRaw = await getCollection('posts');
const localPosts = localPostsRaw.map(p => ({
  title: p.data.title,
  url: withBase(`/blog/${p.slug}/`),
  category: p.data.category ?? 'general',
  tags: p.data.tags ?? [],
  accent: p.data.accent ?? 'bg-site-surface',
  border: p.data.border ?? 'border-site-border'
}));

const posts = [...fetchedPosts, ...localPosts];

// Build map from categories metadata, using localCategories as primary source
const catMap = new Map();
for (const c of localCategories) {
  catMap.set(c.key, {
    key: c.key,
    label: c.label,
    description: c.description,
    accent: c.accent,
    border: c.border,
    order: c.order ?? 999,
    count: 0,
  });
}
for (const post of posts) {
  const key = (post.category || 'general').toString().toLowerCase().replace(/\s+/g, '-');
  if (!catMap.has(key)) {
    catMap.set(key, {
      key,
      label: post.category ?? key,
      description: '',
      accent: post.accent ?? 'bg-site-surface',
      border: post.border ?? 'border-site-border',
      order: 999,
      count: 0,
    });
  }
  catMap.get(key).count++;
}

// Sort categories by order (if present) or by count
const categories = [...catMap.values()]
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999) || b.count - a.count);
---

<Layout
  title={`Blog Categories — ${siteData.name}`}
  description={`Browse all blog categories from ${siteData.name}.`}
>
  <div class="px-6 lg:px-12 py-16">
    <div class="max-w-4xl mx-auto">

      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-sm text-site-muted font-mono">
          <li><a href={withBase('/')} data-astro-reload class="hover:text-site-text transition-colors">Home</a></li>
          <li class="text-site-border">/</li>
          <li><a href={withBase('/blog')} class="hover:text-site-text transition-colors">Blog</a></li>
          <li class="text-site-border">/</li>
          <li class="text-electric-cyan">Categories</li>
        </ol>
      </nav>

      <div class="mb-10">
        <h1 class="font-display font-bold text-4xl sm:text-5xl text-site-text mb-4">Categories</h1>
        <p class="text-site-text-muted text-lg">
          {categories.length} categories across {posts.length} posts.
        </p>
      </div>

      {categories.length === 0 && (
        <p class="text-site-muted font-mono text-sm">
          Categories unavailable — check back soon or visit{" "}
          <a href={personalData.blog_url} class="text-electric-cyan hover:underline" target="_blank" rel="noopener noreferrer">
            {siteData.name} Blog
          </a>.
        </p>
      )}

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {categories.map((category) => (
          <a
            href={withBase(`/blog/categories/${category.key}/`)}
            class={`group block p-5 rounded-3xl border bg-site-surface/30 hover:bg-site-surface/60 transition-all duration-200 ${category.border}`}
          >
            <div class="flex items-center justify-between gap-4 mb-3">
              <span class={`text-xs font-mono font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-site-surface border border-site-border/60 ${category.accent}`}>
                {category.label}
              </span>
              <span class="text-lg font-bold font-mono text-site-text opacity-60 group-hover:opacity-100 transition-opacity">
                {category.count}
              </span>
            </div>
            <p class="text-site-text-muted text-sm leading-relaxed min-h-[4rem]">{category.description || 'Discover more posts in this category.'}</p>
          </a>
        ))}
      </div>

    </div>
  </div>
  <Footer />
</Layout>
