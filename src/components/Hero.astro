---
import { withBase } from '@/lib/assetPath';
import heroData from '@/data/home/hero.json';
import { icons } from '@/lib/icons';

const bgImage = heroData.backgroundImage ? withBase(heroData.backgroundImage) : null;
const bgStyle = bgImage
  ? `background: linear-gradient(180deg, rgba(6,8,10,0.9) 0%, rgba(6,8,10,0.7) 40%), url('${bgImage}') center/cover no-repeat;`
  : "background: linear-gradient(180deg, var(--bg-elevated) 0%, var(--bg-deep) 60%);";

---

<section
  id="home"
  class="relative pt-16 lg:pt-0 overflow-hidden"
  style={bgStyle}
  aria-labelledby="hero-heading"
>
  <!-- Subtle top accent line -->
  <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, var(--color-primary), transparent);"></div>

  <div class="relative z-10 w-full max-w-5xl mx-auto px-6 lg:px-12 pt-10 sm:pt-16 xl:pt-28 pb-2 xl:pb-28">

    <!-- Eyebrow -->
    <div class="flex items-center gap-3 mb-6 animate-fade-in">
      <div class="h-px w-8" style="background: var(--color-primary);"></div>
      <span class="text-xs font-mono font-semibold tracking-[3px] uppercase" style="color: var(--color-primary);">
        {heroData.eyebrow}
      </span>
    </div>

    <!-- Heading -->
    <h1
      id="hero-heading"
      class="font-display font-bold text-5xl sm:text-6xl lg:text-7xl xl:text-8xl text-white uppercase leading-[1.0] tracking-wide mb-4 animate-slide-up"
    >
      {heroData.heading}
    </h1>
    <p
      class="font-display font-bold text-xl sm:text-2xl lg:text-3xl uppercase tracking-widest mb-8 animate-slide-up"
      style="color: var(--color-primary); animation-delay: 0.05s; opacity: 0; animation-fill-mode: forwards;"
    >
      {heroData.subHeading}
    </p>

    <!-- Subheading -->
    <p
      class="text-site-text-muted text-lg sm:text-xl leading-relaxed max-w-2xl mb-10 animate-slide-up"
      style="animation-delay: 0.1s; opacity: 0; animation-fill-mode: forwards;"
    >
      {heroData.blurb}
    </p>

    <!-- Gray band separator -->
    <div class="site-band mb-10 max-w-xs" style="animation-delay: 0.15s;"></div>

    <!-- CTAs -->
    <div
      class="flex flex-wrap gap-4 mb-6 xl:mb-16 animate-slide-up"
      style="animation-delay: 0.2s; opacity: 0; animation-fill-mode: forwards;"
    >
      {heroData.ctas.map((cta) => cta.style === 'primary' ? (
        <a
          href={withBase(cta.href)}
          class="inline-flex items-center gap-2 px-7 py-3.5 text-white font-display font-semibold tracking-[2px] uppercase text-sm shadow-glow-md hover:shadow-glow-lg transition-all duration-300 hover:brightness-110"
          style="background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);"
        >
          {cta.label}
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" set:html={icons['arrow-right']} />
        </a>
      ) : (
        <a
          href={withBase(cta.href)}
          class="inline-flex items-center gap-2 px-7 py-3.5 border text-site-text font-display font-semibold tracking-[2px] uppercase text-sm hover:text-white hover:border-site-green transition-all duration-300"
          style="border-color: var(--color-border); background: var(--bg-surface);"
        >
          {cta.label}
        </a>
      ))}
    </div>

    {heroData.badge && (
      <div class="inline-flex items-center gap-3 mb-8 animate-slide-up" style="animation-delay: 0.25s; opacity: 0; animation-fill-mode: forwards;">
        <span class="text-[11px] font-mono font-semibold uppercase tracking-[3px] rounded-full px-3 py-1" style={heroData.badge.color}>{heroData.badge.label}</span>
        <span class="text-sm text-site-text-muted">{heroData.badge.text}</span>
      </div>
    )}

    {heroData.features && heroData.features.length > 0 && (
      <div class="grid gap-4 sm:grid-cols-3 mb-10 animate-slide-up" style="animation-delay: 0.3s; opacity: 0; animation-fill-mode: forwards;">
        {heroData.features.map((feature) => (
          <div class="rounded-3xl border border-site-border/60 bg-site-surface/70 p-5 backdrop-blur-sm shadow-[0_0_40px_rgba(0,0,0,0.04)]">
            <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-navy-800 text-electric-cyan mb-4" set:html={icons[feature.icon]} />
            <h3 class="font-display font-semibold text-base text-site-text mb-2">{feature.title}</h3>
            <p class="text-site-text-muted text-sm leading-relaxed">{feature.desc}</p>
          </div>
        ))}
      </div>
    )}

    {heroData.testimonial && (
      <div class="rounded-[2rem] border border-site-border/60 bg-site-surface/60 p-8 animate-slide-up" style="animation-delay: 0.35s; opacity: 0; animation-fill-mode: forwards;">
        <p class="text-2xl font-display font-semibold text-white leading-tight mb-4">“{heroData.testimonial.quote}”</p>
        <p class="text-site-green font-semibold">{heroData.testimonial.author}</p>
      </div>
    )}
  </div>
</section>

<!-- Gray band after hero
<div class="site-band"></div>
 -->
